<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/formulariocrear"
    android:background="@drawable/homebackground"
    android:padding="16dp"
    tools:context=".FormularioCrear">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regresar"
                android:fontFamily="@font/revine"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/black"
                android:textSize="25dp"
                android:id="@+id/regresar"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:fontFamily="@font/revine"
                android:textColor="@color/black"
                android:text="Que quieres crear?"
                android:paddingBottom="20dp"
                />
            <CheckBox
                android:id="@+id/checkvideojuegos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:fontFamily="@font/revine"
                android:textColor="@color/black"
                android:text=" Videojuegos"
                />

            <CheckBox
                android:id="@+id/checkredsocial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:fontFamily="@font/revine"
                android:textColor="@color/black"
                android:text=" Red Social"
                />

            <CheckBox
                android:id="@+id/checkeditoriv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:fontFamily="@font/revine"
                android:textColor="@color/black"
                android:text=" Editor IV"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/revine"
                android:hint="Colores a agregar"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="25sp"
                android:background="@drawable/border"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/coloresapedido"
                />
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/revine"
                android:hint="Secciones a agregar:"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:textSize="25sp"
                android:background="@drawable/border"
                android:padding="18dp"
                android:inputType="text"
                android:id="@+id/seccionesapedido"
                />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/enviar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:text="asd"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:drawableBottom="@drawable/envi"
                />

        </RelativeLayout>


    </LinearLayout>


</RelativeLayout>