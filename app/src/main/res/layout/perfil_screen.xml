<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/home"
    android:background="@drawable/homebackground"
    android:gravity="start"
    android:padding="16dp"
    tools:context=".Perfil"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        >

        <ImageView
            android:layout_width="100sp"
            android:layout_height="100sp"
            android:background="@drawable/profile_rounded"
            android:src="@drawable/amaa" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="20sp"
            >

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/perfil" />

            <TextView
                android:background="@drawable/border"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="20sp"
                android:padding="10dp"
                android:textColor="@color/white"
                android:fontFamily="@font/revine"
                android:text=" Jada Hernan"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="40sp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/mail" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/border"

                android:fontFamily="@font/revine"
                android:text=" diegohernandezz2006@gmail.com"
                android:textAlignment="textEnd"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="40sp"
            >

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/contra" />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="40sp"
                android:background="@drawable/border"
                android:fontFamily="@font/revine"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:text=": 123456"
                android:padding="5sp"
                />

        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/salir"
                android:layout_width="50sp"
                android:layout_height="70sp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:drawableBottom="@drawable/cerrar"
                android:text="asd"
                />

            <Button
                android:id="@+id/regreso"
                android:layout_width="50sp"
                android:layout_height="70sp"
                android:layout_alignParentBottom="true"
                android:background="@android:color/transparent"
                android:drawableBottom="@drawable/baseline_arrow_back_24"
                android:text="asd"
                />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>